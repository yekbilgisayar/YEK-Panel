<Window x:Class="YekPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YEK Panel" Width="424" Height="900"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="Window_KeyDown">

    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D2340" Offset="0" />
            <GradientStop Color="#091A30" Offset="0.55" />
            <GradientStop Color="#050F1E" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentBar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2F7DF6" Offset="0" />
            <GradientStop Color="#4CC9F0" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentButtonBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#38BDF8" Offset="0" />
            <GradientStop Color="#7DD3FC" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="AccentText" Color="#7FD6F7" />
        <SolidColorBrush x:Key="AccentSoft" Color="#4CC9F0" />
        <SolidColorBrush x:Key="AccentDeep" Color="#2F7DF6" />

        <DropShadowEffect x:Key="WindowShadow" BlurRadius="32" ShadowDepth="0" Opacity="0.6" Color="#000000" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#12304F" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BorderBrush" Value="#1D4470" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
        </Style>

        <Style x:Key="CardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#5F7FA6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#93B2D6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#EAF4FF" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetricBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBar}" />
            <Setter Property="Background" Value="#10294A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="3.5" />
                            <Border x:Name="PART_Track" Background="Transparent" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3.5" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8FB4DA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A4069" />
                                <Setter Property="Foreground" Value="#EAF4FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F2A4A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8E2424" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6E1A1A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A9C6E6" />
            <Setter Property="Background" Value="#102A4B" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A4069" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0E2643" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#04121F" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource AccentButtonBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0A1E38" />
            <Setter Property="Foreground" Value="#E7F1FF" />
            <Setter Property="BorderBrush" Value="#1C4677" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentSoft}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12304F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0B2038" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7396BE" />
            <Setter Property="Margin" Value="2,0,0,3" />
        </Style>

        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C7D8EF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="17" Height="17" CornerRadius="4" Background="#0A1E38"
                                    BorderBrush="#1C4677" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock x:Name="Tick" Text="✓" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentSoft}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="7">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="5">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2E547F" CornerRadius="2.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootCard" Margin="10" CornerRadius="20" Background="{StaticResource WindowBg}"
            BorderBrush="#1D4B7C" BorderThickness="1" Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Başlık çubuğu -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#34D399" Margin="0,0,8,0" />
                    <TextBlock Text="YEK PANEL" FontSize="11" FontWeight="Bold" Foreground="#9CC4E8" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderVersionText" Text="v2.2" FontSize="10" Foreground="#527099" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="MiniButton" Style="{StaticResource IconButton}" Content="&#xE740;"
                            ToolTip="Mini mod (Ctrl+M)" Click="Mini_Click"
                            AutomationProperties.Name="Mini mod" Margin="0,0,2,0" />
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" FontFamily="Segoe UI"
                            FontSize="13" Content="&#x21E7;" ToolTip="Her zaman üstte" Click="Pin_Click"
                            AutomationProperties.Name="Her zaman üstte" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Content="&#xE921;"
                            ToolTip="Küçült" Click="Minimize_Click"
                            AutomationProperties.Name="Küçült" Margin="2,0,0,0" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseIconButton}" Content="&#xE8BB;"
                            ToolTip="Kapat" Click="Close_Click"
                            AutomationProperties.Name="Kapat" Margin="2,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- Marka / saat -->
            <Grid x:Name="BrandRow" Grid.Row="1" Margin="20,2,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="64" Height="82" CornerRadius="14" BorderBrush="#1E4C7E" BorderThickness="1">
                    <Border.Background>
                        <ImageBrush ImageSource="Assets/logo.png" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="YEK BİLGİSAYAR" FontSize="19" FontWeight="Bold" Foreground="#F2F8FF" />
                    <TextBlock Text="MODERN TEKNOLOJİ" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentSoft}" Margin="0,2,0,0" />
                    <TextBlock x:Name="ClockText" Text="00:00:00" FontFamily="Consolas" FontSize="24"
                               FontWeight="Bold" Foreground="#EAF4FF" Margin="0,5,0,0" />
                    <TextBlock x:Name="DateText" Text="—" FontSize="11" Foreground="#8FA9CC" Margin="0,1,0,0" />
                </StackPanel>

                <Button x:Name="WeatherChip" Grid.Column="2" Style="{StaticResource ChipButton}"
                        VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0"
                        ToolTip="Hava durumu yükleniyor…" Click="WeatherChip_Click"
                        AutomationProperties.Name="Hava durumu detayı">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="WeatherGlyph" Text="☀" FontFamily="Segoe UI Symbol" FontSize="20"
                                       Foreground="{DynamicResource AccentSoft}" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock x:Name="WeatherTemp" Text="—" FontSize="21" FontWeight="SemiBold" Foreground="#EAF4FF" />
                        </StackPanel>
                        <TextBlock x:Name="WeatherDesc" Text="hava durumu" FontSize="9.5" Foreground="#8FA9CC"
                                   HorizontalAlignment="Right" MaxWidth="104" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="WeatherCity" Text="" FontSize="9" Foreground="#5F7FA6"
                                   HorizontalAlignment="Right" MaxWidth="104" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="WeatherForecast" Text="" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentSoft}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                   MaxWidth="112" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- İçerik -->
            <ScrollViewer x:Name="ContentScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MainCardsPanel">
                    <Border x:Name="ComputerCard" Style="{StaticResource Card}" Margin="20,0,20,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="BİLGİSAYAR" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="MachineText" Text="—" Style="{StaticResource CardHint}"
                                           Foreground="#7E9FC6" FontSize="10.5"
                                           HorizontalAlignment="Right" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="İŞLEMCİ" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="CpuValue" Grid.Column="1" Text="—" Style="{StaticResource MetricValue}" />
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="26" Margin="0,6,0,0">
                                    <Border Background="#0A1E38" CornerRadius="5" />
                                    <Canvas x:Name="CpuChart" Height="26" ClipToBounds="True" Background="Transparent" />
                                </Grid>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="BELLEK" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="RamValue" Grid.Column="1" Text="—" Style="{StaticResource MetricValue}" />
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="26" Margin="0,6,0,0">
                                    <Border Background="#0A1E38" CornerRadius="5" />
                                    <Canvas x:Name="RamChart" Height="26" ClipToBounds="True" Background="Transparent" />
                                </Grid>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DİSK (C:)" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="DiskValue" Grid.Column="1" Text="—" Style="{StaticResource MetricValue}" />
                                <ProgressBar x:Name="DiskBar" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource MetricBar}"
                                             Minimum="0" Maximum="100" Value="0" Margin="0,6,0,0" />
                            </Grid>

                            <Border Height="1" Background="#153758" Margin="0,13,0,11" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="ÇALIŞMA" Style="{StaticResource MetricLabel}" />
                                    <TextBlock x:Name="UptimeText" Text="—" Style="{StaticResource MetricValue}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel x:Name="InternetBox" Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" ToolTip="İnternet ölçülüyor…">
                                    <TextBlock Text="İNTERNET" Style="{StaticResource MetricLabel}" />
                                    <Ellipse x:Name="InternetDot" Width="6" Height="6" Fill="#3C5A7D"
                                             Margin="7,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="InternetText" Text="—" Style="{StaticResource MetricValue}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,7,0,0" ToolTip="Anlık indirme / yükleme hızı">
                                <TextBlock Text="AĞ" Style="{StaticResource MetricLabel}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="↓" FontSize="12" Foreground="{DynamicResource AccentSoft}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="DownloadText" Text="—" Style="{StaticResource MetricValue}" Margin="4,0,0,0" />
                                    <TextBlock Text="↑" FontSize="12" Foreground="{DynamicResource AccentDeep}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <TextBlock x:Name="UploadText" Text="—" Style="{StaticResource MetricValue}" Margin="4,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <TextBlock Text="SICAKLIK" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="TempValue" Text="—" Style="{StaticResource MetricValue}"
                                           ToolTip="CPU / GPU sıcaklıkları. Sensörler yönetici izni isteyebilir." />
                            </Grid>

                            <Grid Margin="0,7,0,0" ToolTip="Anlık GPU kullanımı">
                                <TextBlock Text="GPU" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="GpuValue" Text="—" Style="{StaticResource MetricValue}"
                                           AutomationProperties.AutomationId="GpuLoad" />
                            </Grid>
                            <ProgressBar x:Name="GpuBar" Style="{StaticResource MetricBar}" Minimum="0" Maximum="100"
                                         Value="0" Margin="0,5,0,0" />
                            <Grid Margin="0,5,0,0" ToolTip="Kullanılan / toplam ekran kartı belleği">
                                <TextBlock Text="VRAM" Style="{StaticResource MetricLabel}" />
                                <TextBlock x:Name="VramValue" Text="—" Style="{StaticResource MetricValue}"
                                           AutomationProperties.AutomationId="GpuVram" />
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="HIZ TESTİ" Style="{StaticResource MetricLabel}" />
                                    <TextBlock x:Name="SpeedTestValue" Text="—" Style="{StaticResource MetricValue}" Margin="8,0,0,0" />
                                </StackPanel>
                                <Button x:Name="SpeedTestButton" Content="TEST ET" Style="{StaticResource ChipButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9.5"
                                        FontWeight="SemiBold" Foreground="{DynamicResource AccentSoft}"
                                        Click="SpeedTest_Click" ToolTip="İndirme hızını ölçer (yaklaşık 8 saniye)"
                                        AutomationProperties.Name="Hız testi yap" />
                            </Grid>

                            <Border Height="1" Background="#153758" Margin="0,13,0,11" />

                            <Grid>
                                <TextBlock Text="SÜREÇLER" Style="{StaticResource CardTitle}" />
                                <TextBlock Text="EN YOĞUN 5 · KAPAT" Style="{StaticResource CardHint}" HorizontalAlignment="Right" />
                            </Grid>
                            <StackPanel x:Name="ProcessesList" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Sistem & bağlantı kartı -->
                    <Border x:Name="ConnectionCard" Style="{StaticResource Card}" Margin="20,0,20,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="SİSTEM &amp; BAĞLANTI" Style="{StaticResource CardTitle}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="MainConnStatus" Text="güncelleniyor…" FontSize="9"
                                               Foreground="#5F7FA6" VerticalAlignment="Center"
                                               MaxWidth="118" TextTrimming="CharacterEllipsis" />
                                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Width="24"
                                            Height="20" FontSize="10" Margin="3,0,0,0"
                                            ToolTip="Bağlantı bilgilerini şimdi yenile" Click="RefreshConnection_Click"
                                            AutomationProperties.Name="Bağlantı bilgilerini yenile" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,9,0,0">
                                <TextBlock Text="PİL" Style="{StaticResource MetricLabel}" FontSize="10.5" />
